# systemd unit that starts the app at boot on the Compute Engine VM.
#
# Install:
#   sudo cp docker/dookwebsite.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dookwebsite
#
# Operate:
#   sudo systemctl status dookwebsite
#   sudo systemctl restart dookwebsite
#   journalctl -u dookwebsite -f

[Unit]
Description=dookwebsite (nginx + php-fpm container)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

# The database is only reachable through the VPN tunnel, and this app talks
# to the database during startup - docker/entrypoint.sh runs
# `artisan package:discover`, which this codebase resolves with a DB query.
# Starting the container before the tunnel is up makes that fail.
#
# Deliberately Wants=, not Requires=. Requires= was tried first and is
# WRONG here: it doesn't just order startup, it also STOPS this unit
# whenever openvpn-client@dook stops - including a routine `systemctl
# restart`, which is exactly what dookwebsite-vpn-healthcheck.timer does to
# recover a stalled tunnel. That combination would take the whole site down
# on every recovery and never bring it back (Requires= propagates stops,
# not restarts). Confirmed by reproducing it: stopping the tunnel for a
# deliberate failure test cascaded into killing the running container.
#
# Wants=+After= keeps the original intent - try to have the tunnel up
# before this starts - without coupling this unit's continued liveness to
# the tunnel's. A dropped tunnel now degrades individual requests (DB calls
# fail, existing fallbacks handle it) instead of taking nginx down with it.
Wants=openvpn-client@dook.service
After=openvpn-client@dook.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dookwebsite

# Optional. Only needed once you build images off the VM and pull them from
# Artifact Registry:
#   IMAGE=<region>-docker.pkg.dev/<project>/dookwebsite/app:<tag>
# When absent, docker-compose.prod.yml falls back to the locally built
# dookwebsite:prod image. The '-' prefix makes a missing file non-fatal.
EnvironmentFile=-/etc/dookwebsite/deploy.env

# Starts whatever image is already present - it does not build or pull.
# Deploying a new version is a deliberate step (see the redeploy section of
# explainers/gcp_hosting_guide.md), not something a reboot does silently.
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down

TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
