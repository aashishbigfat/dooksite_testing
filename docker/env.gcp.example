# Template for /etc/dookwebsite/app.env on the Compute Engine VM.
#
#   sudo mkdir -p /etc/dookwebsite
#   sudo cp docker/env.gcp.example /etc/dookwebsite/app.env
#   sudo chmod 600 /etc/dookwebsite/app.env    # contains DB and Redis passwords
#   sudo nano /etc/dookwebsite/app.env
#
# Injected as real container environment variables by docker-compose.prod.yml,
# never copied into an image layer.
#
# This is a template with placeholder values - it is safe to commit. Do not
# commit the filled-in copy.

APP_NAME=Dook
APP_ENV=production
# php artisan key:generate --show
APP_KEY=base64:REPLACE_ME
APP_DEBUG=false
APP_TIMEZONE=UTC

# Must match the origin you actually browse, exactly - Laravel builds every
# absolute URL and asset link from this.
#
# While verifying on the VM's external IP, use the IP and plain http:
#   APP_URL=http://34.x.x.x
#   ASSET_URL=http://34.x.x.x
# Leave https:// and the custom domain out until DNS is pointed at the VM,
# or every CSS/JS/image link on the page will point at the live site instead
# of the one you are testing.
APP_URL=http://REPLACE_WITH_VM_EXTERNAL_IP
ASSET_URL=http://REPLACE_WITH_VM_EXTERNAL_IP
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# stderr so the container's log driver forwards it to Cloud Logging, rather
# than accumulating in a file inside the container.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Cloud SQL -------------------------------------------------------------
# Private IP, reached directly because the VM sits in the same VPC. Unchanged
# from the current setup, so no connector or auth proxy is involved.
DB_CONNECTION=mysql
DB_HOST=192.168.4.7
DB_PORT=3306
DB_DATABASE=dookweb
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME

# --- Sessions --------------------------------------------------------------
# file works because this runs as a single instance. If you ever put more
# than one VM behind a load balancer, switch this to redis (and re-check the
# 30-connection budget in docker/www.conf) or users will be logged out at
# random as requests land on different machines.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# MUST be empty while browsing by IP address.
#
# A domain-scoped cookie (.dooktravels.com) is simply not set by the browser
# when the host is an IP, so the session silently never persists - login,
# the booking flow and anything else stateful appear broken with no error
# anywhere. Set this to .dooktravels.com only when DNS is switched over.
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- Redis -----------------------------------------------------------------
# Redis Cloud. Confirm the instance region matches the VM's region: the
# database indexes made the queries this cache replaces sub-millisecond, so a
# cross-region Redis would be slower than not caching at all.
CACHE_STORE=redis
CACHE_PREFIX=dook_
REDIS_CLIENT=predis
REDIS_HOST=REPLACE_ME.db.redis.io
REDIS_PORT=REPLACE_ME
REDIS_USERNAME=default
REDIS_PASSWORD=REPLACE_ME
# The plan exposes database 0 only - index 1 returns "DB index is out of range".
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PERSISTENT=true
REDIS_TIMEOUT=2.0
REDIS_READ_TIMEOUT=2.0

# --- Google Cloud Storage --------------------------------------------------
# GOOGLE_CLOUD_KEY_FILE is intentionally ABSENT.
#
# Leaving it unset makes generateSignedUrl() fall through to Application
# Default Credentials, i.e. the VM's attached service account, so no private
# key exists on the VM. Setting it to a path that does not exist would break
# every image on the site silently.
#
# The attached service account needs:
#   roles/storage.objectViewer            on the bucket
#   roles/iam.serviceAccountTokenCreator  on ITSELF (to sign URLs via IAM)
GOOGLE_CLOUD_STORAGE_BUCKET=dooktravels/com

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_ME
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_FROM_ADDRESS=REPLACE_ME
MAIL_FROM_NAME="${APP_NAME}"
